/** @type {import('next').NextConfig} */
const nextConfig = {
  async headers() {
    return [
      {
        // Remove Cross-Origin-Opener-Policy that blocks Firebase auth popup/redirect
        source: "/(.*)",
        headers: [
          {
            key: "Cross-Origin-Opener-Policy",
            value: "same-origin-allow-popups",
          },
        ],
      },
    ];
  },
};

module.exports = nextConfig;